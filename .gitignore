#.gitignore
data/
__pycache__/
.env
*.pyc

mlruns/


# ---------------------------------------------
# 1. Operating System Files
# ---------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------
# 2. Python Bytecode and Metadata
# ---------------------------------------------
# Byte-compiled / optimized / setuptools files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ---------------------------------------------
# 3. Virtual Environments
# ---------------------------------------------
# Virtual environments:
venv/
.venv/
env/
# Specific environment names
*.egg-info/
.Python

# ---------------------------------------------
# 4. Jupyter, IPython, and Colab
# ---------------------------------------------
# Jupyter/Colab checkpoints (already covered, but good to keep here)
.ipynb_checkpoints
profile_default/
ipython_config.py
nbpresent.json

# ---------------------------------------------
# 5. IDE Specific Files
# ---------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json # Optionally commit settings
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm/IntelliJ
.idea/

# ---------------------------------------------
# 6. Data & Model Files (CRUCIAL for Data Science)
# ---------------------------------------------
# NEVER commit raw data or large trained models.
# Only commit small, clean sample datasets if necessary.
/data/raw/
/data/external/
*.csv
*.txt
*.xlsx
*.parquet
*.feather




# Logs and results
*.log
/logs/
/results/


# --- MLflow Artifacts and Generated Files to Ignore ---
#models/*.pkl
#models/feature_engine_v*/
# Optionally exclude notebooks if they are large
notebooks/*.ipynb 
output.png
reports/
